# White Force Attendance - Environment Configuration Template
# Copy this file to .env and configure your local or production values.
# NEVER commit your actual .env file or production keys to version control!

# Base API Configuration
API_BASE_URL=https://whiteforcepayroll.com/admin/api

# Google Maps API Keys (Optional if set directly in AndroidManifest.xml / AppDelegate.mm)
GOOGLE_MAPS_API_KEY_ANDROID=your_android_google_maps_key_here
GOOGLE_MAPS_API_KEY_IOS=your_ios_google_maps_key_here

# App Environment
ENV=development
